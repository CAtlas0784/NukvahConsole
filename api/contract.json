        "type": "array",
        "items": {
          "$ref": "#/definitions/CatalogCharacter"
        }
      }
    },
    {
      "method": "GET",
      "path": "/catalog/items",
      "role": "viewer",
      "proposed": "GET /api/v1/catalog/items",
