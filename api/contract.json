      "type": "object",
      "properties": {
        "apply": {
          "type": "boolean"
        }
      }
    },
    "PatchItemRequest": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer"
        },
        "refinement": {
          "type": "integer"
        },
        "mainPropId": {
          "type": "integer"
        },
        "appendPropIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "custom"
          ]
        },
        "promoteLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "WorldLevelRequest": {
      "type": "object",
      "properties": {
        "worldLevel": {
          "type": "integer"
        }
      },
      "required": [
        "worldLevel"
      ]
    },
    "TeleportRequest": {
      "type": "object",
      "properties": {
        "sceneId": {
          "type": "integer"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "pointId": {
          "type": "integer",
          "description": "a point of the scene; the server lands on its own tranPos/pos. Not combined with x/y/z."
        }
      },
      "required": [
        "sceneId"
      ]
    },
    "SpawnRequest": {
      "type": "object",
      "properties": {
        "monsterId": {
          "type": "integer"
        },
        "amount": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        }
      },
      "required": [
        "monsterId",
        "amount",
        "level"
      ]
    },
    "ExecuteRequest": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "integer"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "command"
      ]
    },
    "RouteInfo": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "write": {
          "type": "boolean"
        },
        "audit": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "path",
        "role",
        "write"
      ]
    },
    "DeleteItemResult": {
      "type": "object",
      "properties": {
        "deleted": {
          "$ref": "#/definitions/InventoryItem"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "deleted",
        "success"
      ]
    }
  },
  "routes": [
    {
      "method": "GET",
      "path": "/health",
      "auth": "none",
      "response": "object"
    },
    {
      "method": "GET",
      "path": "/status",
      "role": "viewer",
      "response": "ServerStatus (src/api/nukva.ts)"
    },
    {
      "method": "GET",
      "path": "/routes",
      "role": "viewer",
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/RouteInfo"
        }
      }
    },
    {
      "method": "GET",
      "path": "/players",
      "role": "viewer",
      "response": "OnlinePlayer[]"
    },
    {
      "method": "GET",
      "path": "/players/{uid}",
      "role": "viewer",
      "response": "PlayerSummary",
      "errors": [
        "PLAYER_NOT_FOUND",
        "PLAYER_OFFLINE"
      ]
    },
    {
      "method": "GET",
      "path": "/players/{uid}/avatars",
      "role": "viewer",
      "response": "OwnedAvatar[]",
      "errors": [
        "PLAYER_NOT_FOUND",
        "PLAYER_OFFLINE"
      ]
    },
    {
      "method": "GET",
      "path": "/players/{uid}/inventory",
