{
  "$comment": "Nukva bridge API contract (SnezhnayaCore /nukva/v1). Source of truth for src/api/generated.ts (npm run api:types) and for the route check against the live server's GET /routes. Schema subset: type object/array/string/integer/number/boolean/null, properties, required, items, enum, additionalProperties, oneOf, $ref (#/definitions/X), nullable.",
  "basePath": "/nukva/v1",
  "apiVersion": 1,
  "envelope": {
    "success": "{ ok: true, data: <response> }",
    "error": "{ ok: false, error: { code, detail?, message }, data?: <partial state> } with the HTTP status listed per code"
  },
  "headers": {
    "Idempotency-Key": "optional on every write; 8-128 printable ASCII. A repeat with the same key and request returns the stored result (response header Idempotency-Replayed: true) instead of running again."
  },
  "errors": {
    "ORIGIN_NOT_ALLOWED": {
      "status": 403,
      "when": "browser Origin not in nukva.json allowedOrigins"
    },
    "LOCAL_ONLY": {
      "status": 403,
      "when": "request did not come from this machine's loopback (or went through a proxy)"
    },
    "RATE_LIMITED": {
      "status": 429,
      "when": "requests or writes per minute exceeded"
    },
    "FORBIDDEN": {
      "status": 403,
      "when": "role too low for the route"
    },
    "PERMISSION_DENIED": {
      "status": 403,
      "when": "target UID not writable per nukva.json targets (allowUids / denyUids)"
    },
    "INVALID_IDEMPOTENCY_KEY": {
      "status": 400,
      "when": "Idempotency-Key malformed"
    },
    "IN_PROGRESS": {
      "status": 409,
      "when": "same Idempotency-Key still running (or timed out on the game thread)"
    },
    "IDEMPOTENCY_KEY_REUSED": {
      "status": 422,
      "when": "same Idempotency-Key used for a different request"
    },
    "INVALID_JSON": {
      "status": 400,
      "when": "body is not valid JSON for the operation"
    },
    "MISSING_BODY": {
      "status": 400,
      "when": "no body / nothing to change"
    },
    "MISSING_FIELD": {
      "status": 400,
      "when": "a required field is absent"
    },
    "INVALID_NUMBER": {
      "status": 400,
      "when": "a path number is not an integer"
    },
    "OUT_OF_RANGE": {
      "status": 400,
      "when": "a value is outside the allowed range"
    },
    "INVALID_TYPE": {
      "status": 400,
      "when": "unknown item type filter"
    },
    "UNKNOWN_AVATAR": {
      "status": 400,
      "when": "avatar id not in the server's game data"
    },
    "UNKNOWN_ITEM": {
      "status": 400,
      "when": "item id not in the server's game data"
    },
    "UNKNOWN_MONSTER": {
      "status": 400,
      "when": "monster id not in the server's game data"
    },
    "UNKNOWN_SCENE": {
      "status": 400,
      "when": "scene id not in the server's game data"
    },
    "NOT_AN_ARTIFACT": {
      "status": 400,
      "when": "item is not an artifact"
    },
    "NOT_A_WEAPON": {
      "status": 400,
      "when": "refinement given for a non-weapon"
    },
    "NOT_EQUIPMENT": {
      "status": 400,
      "when": "item cannot be equipped or edited"
    },
    "INVALID_GUID": {
      "status": 400,
      "when": "guid is not a positive integer"
    },
    "INVALID_SLOT": {
      "status": 400,
      "when": "slot is not flower/plume/sands/goblet/circlet"
    },
    "WEAPON_REQUIRED": {
      "status": 400,
      "when": "attempt to unequip a weapon"
    },
    "INVALID_POSITION": {
      "status": 400,
      "when": "non-finite coordinates"
    },
    "BATCH_TOO_LARGE": {
      "status": 400,
      "when": "more than limits.maxBatchSize entries"
    },
    "UNSUPPORTED_OPERATION": {
      "status": 400,
      "when": "the target exists but the operation is not supported for it (detail NOT_PLAYABLE: trial/test/UGC avatar)"
    },
    "INVALID_ARTIFACT_CONFIG": {
      "status": 400,
      "when": "artifact stats invalid; detail is one of INVALID_MAIN_STAT, MAIN_STAT_NOT_ALLOWED_FOR_SLOT, MAIN_STAT_REQUIRED, INVALID_SUBSTAT, TOO_MANY_SUBSTATS, TOO_MANY_SUBSTAT_TYPES, SUBSTAT_EQUALS_MAIN, DUPLICATE_INITIAL_SUBSTAT, UPGRADE_BEFORE_FOUR_TYPES, ROLL_COUNT_MISMATCH, INVALID_INITIAL_SUBSTATS, ROLLS_NOT_ALLOWED, RANDOM_ROLL_UNAVAILABLE (409)"
    },
    "PLAYER_NOT_FOUND": {
      "status": 409,
      "when": "no player with this UID exists"
    },
    "PLAYER_OFFLINE": {
      "status": 409,
      "when": "player exists but is offline (writes apply to online players only)"
    },
    "AVATAR_NOT_OWNED": {
      "status": 409,
      "when": "player does not own the character"
    },
    "ALREADY_OWNED": {
      "status": 409,
      "when": "character already owned"
    },
    "ITEM_NOT_FOUND": {
      "status": 409,
      "when": "no item with this guid / artifact id unknown"
    },
    "ITEM_EQUIPPED_ELSEWHERE": {
      "status": 409,
      "when": "item equipped on another character"
    },
    "SLOT_EMPTY": {
      "status": 409,
      "when": "nothing to unequip"
    },
    "INVENTORY_FULL": {
      "status": 409,
      "when": "weapons/artifacts would exceed the inventory tab capacity; nothing was added"
    },
    "NO_SCENE": {
      "status": 409,
      "when": "player not in a scene"
    },
    "SCENE_UNAVAILABLE": {
      "status": 400,
      "when": "scene could not be loaded"
    },
    "NOT_APPLIED": {
      "status": 409,
      "when": "the server's own method refused the change"
    },
    "STATE_VERIFICATION_FAILED": {
      "status": 409,
      "when": "the change ran but the read-back did not show it; data holds the state that was read"
    },
    "SERVER_UNAVAILABLE": {
      "status": "503/504",
      "when": "no game server in this process (503) or the game thread did not finish in time (504, detail GAME_THREAD_TIMEOUT; re-read state)"
    },
    "OPERATION_FAILED": {
      "status": 500,
      "when": "the game server raised an unexpected error while applying the operation; re-read state"
    },
    "INTERRUPTED": {
      "status": 500,
      "when": "the bridge thread was interrupted while waiting for the game thread; re-read state"
    },
    "RAW_COMMANDS_DISABLED": {
      "status": 403,
      "when": "raw command execution off"
    },
    "COMMAND_NOT_ALLOWED": {
      "status": 403,
      "when": "command not in the allowlist"
    },
    "UNKNOWN_COMMAND": {
      "status": 400,
      "when": "no such command"
    },
    "INVALID_COMMAND": {
      "status": 400,
      "when": "empty, too long, control characters or @targets"
    },
    "INTERNAL_ERROR": {
      "status": 500,
      "when": "unexpected server error (logged)"
    },
    "INVALID_MODE": {
      "status": 400,
      "when": "artifact mode is not normal or custom"
    },
    "SLOT_OCCUPIED": {
      "status": 409,
      "when": "equipping an artifact into a slot that holds another one without replace: true; data.current is the worn piece"
    },
    "ITEM_EQUIPPED": {
      "status": 409,
      "when": "deleting an artifact that is equipped (unequip first)"
    },
    "CONFIRMATION_REQUIRED": {
      "status": 400,
      "when": "delete without ?confirm=<same guid>"
    },
    "UNSUPPORTED_ITEM": {
      "status": 400,
      "when": "the item exists but the server cannot give it (detail: NO_SERVER_HANDLER, CONSUMED_ON_GAIN, USE_CHARACTER_BUILDER, SERVER_REFUSES, NOT_A_COMBAT_WEAPON, NOT_A_SET_PIECE, NO_ITEM_TYPE, UNSUPPORTED_TYPE)"
    },
    "STACK_LIMIT_EXCEEDED": {
      "status": 409,
      "when": "current count + requested amount is above the item's stack limit (data: current, limit, maxAddable); nothing is added"
    },
    "INVALID_ASCENSION": {
      "status": 400,
      "when": "promoteLevel is not valid for the level (data.allowed lists the valid ones)"
    },
    "WEAPON_TYPE_MISMATCH": {
      "status": 409,
      "when": "the weapon's type is not the character's weapon type"
    },
    "POINT_NOT_FOUND": {
      "status": 409,
      "when": "the scene has no such point in the server's loaded point data (data.loadedPoints = how many it has)"
    }
  },
  "definitions": {
    "Slot": {
      "type": "string",
      "enum": [
        "flower",
        "plume",
        "sands",
        "goblet",
        "circlet"
