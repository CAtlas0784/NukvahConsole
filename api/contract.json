      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/InventoryItem"
        }
      },
      "errors": [
        "PLAYER_NOT_FOUND",
        "PLAYER_OFFLINE"
      ]
    },
    {
      "method": "GET",
      "path": "/players/{uid}/artifacts",
      "role": "viewer",
      "proposed": "GET /api/v1/players/{uid}/artifacts",
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/InventoryItem"
        }
      },
      "errors": [
        "PLAYER_NOT_FOUND",
        "PLAYER_OFFLINE"
      ]
    },
    {
      "method": "GET",
      "path": "/commands",
      "role": "viewer",
      "response": "CommandInfo[]"
    },
    {
      "method": "GET",
      "path": "/audit",
