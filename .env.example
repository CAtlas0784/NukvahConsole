# Nukvah Console build-time settings. Everything here ends up in PUBLIC JavaScript.
# NEVER put tokens, passwords or database credentials in this file.

# Base path. "/" for Vercel/local; "/<repository>/" for a GitHub Pages project site.
# The GitHub Actions workflow sets this automatically.
VITE_BASE_PATH=/

# Optional: pre-fill the server URL on the connect screen (default http://127.0.0.1:8088).
# The bridge is local-only: use a loopback address (127.0.0.1 / localhost) and the HTTP listener port.
VITE_DEFAULT_API_URL=

# Optional: base URL of artwork YOU host and are allowed to use. Files are requested as
# <base>/<IconName>.png (e.g. UI_AvatarIcon_Ayaka.png). Leave empty to use generated sigils.
VITE_ASSET_BASE_URL=
